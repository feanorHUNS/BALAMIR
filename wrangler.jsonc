{
  "name": "balamir",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",

  // ------------------------------------------------------------------
  // ORTAM DEĞİŞKENLERİ
  //
  // DİKKAT: Buradaki "vars" bloğu, Cloudflare tarafından DÜZ METİN
  // değişkenlerin TAM LİSTESİ olarak kabul edilir. Dashboard'da olup
  // burada OLMAYAN düz metin değişkenler her deploy'da SİLİNİR.
  // Bu yüzden gizli olmayan TÜM değişkenler burada listelenmelidir.
  //
  // Buradakilerin hiçbiri gizli bilgi değildir:
  //  - FIREBASE_API_KEY / FIREBASE_DB_URL : zaten index.html içinde açık
  //  - DISCORD_PUBLIC_KEY : adı üstünde "public"; imza DOĞRULAMAK için
  //    kullanılır, imza ÜRETMEK için değil. Discord portalda açıkça gösterir.
  //  - DISCORD_CHANNEL_ID : sadece bir kanal numarası
  //
  // GİZLİ olanlar Cloudflare Dashboard'da "Gizli" (Secret) olarak kalmalı,
  // buraya ASLA yazılmamalı:
  //   DISCORD_BOT_TOKEN
  //   FIREBASE_DB_SECRET
  // ------------------------------------------------------------------
  "vars": {
    "FIREBASE_DB_URL": "https://hunsguild-default-rtdb.firebaseio.com",
    "FIREBASE_API_KEY": "AIzaSyBKOIS5aTqw6YuTiCq1q0xpeK_sdJtssCo",
    "DISCORD_CHANNEL_ID": "1386044843461181460",
    "DISCORD_PUBLIC_KEY": "BURAYA_PUBLIC_KEY_YAPISTIR"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
