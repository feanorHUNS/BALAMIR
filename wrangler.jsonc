{
  "name": "balamir",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",

  // ------------------------------------------------------------------
  // ORTAM DEĞİŞKENLERİ
  //
  // Buradaki "vars" bloğu, Cloudflare tarafından DÜZ METİN değişkenlerin
  // TAM LİSTESİ olarak kabul edilir: dashboard'da olup burada olmayan düz
  // metin değişkenler her deploy'da SİLİNİR.
  //
  // "Secret" tipindeki değişkenler bundan ETKİLENMEZ — deploy onlara
  // dokunmaz. Bu yüzden değeri bilinmeyen / gizli olan her şey Secret
  // olarak Dashboard'da tutulur ve buraya YAZILMAZ.
  //
  // Dashboard'da SECRET olarak durması gerekenler:
  //   DISCORD_BOT_TOKEN     (bot yetkisi)
  //   DISCORD_PUBLIC_KEY    (Discord imza doğrulaması — butonlar bunsuz çalışmaz)
  //   FIREBASE_DB_SECRET    (worker'ın Firebase'e yazma yetkisi)
  //
  // Aşağıdakiler gizli değil, değerleri zaten index.html içinde açık:
  // ------------------------------------------------------------------
  "vars": {
    "FIREBASE_DB_URL": "https://hunsguild-default-rtdb.firebaseio.com",
    "FIREBASE_API_KEY": "AIzaSyBKOIS5aTqw6YuTiCq1q0xpeK_sdJtssCo",
    "DISCORD_CHANNEL_ID": "1386044843461181460",
    // RSVP hatirlatmasindaki "duyuruya git" baglantisi icin gerekli.
    // Discord'da sunucuya sag tik -> "Sunucu Kimligini Kopyala" ile alinir.
    "DISCORD_GUILD_ID": "708338642522865705",

    // ------------------------------------------------------------------
    // ASAGIDAKI IKISI DASHBOARD'A DEGIL BURAYA YAZILIR.
    // Sebep: Cloudflare bu "vars" blogunu duz metin degiskenlerin TAM
    // LISTESI sayar; Dashboard'dan elle eklenen duz metin degiskenler her
    // deploy'da SILINIR. Bu yuzden gizli olmayan bu iki deger burada durur
    // ve deploy'lardan etkilenmez.
    // ------------------------------------------------------------------

    // Slash komutlarini (/hi, /dkp, /match) Discord'a kaydetmek icin gerekli.
    // Discord Developer Portal > uygulaman > General Information > Application ID
    "DISCORD_APPLICATION_ID": "1530955175265828966",

    // Hosgeldin gorselinin saklandigi kanal. Discord embed'i gorseli BAGLANTIYLA
    // gosterdigi icin gorsel once bu kanala yuklenir, sonra kalici baglantisi
    // saklanir. Gizli bir "depo" kanali acip kimligini buraya yaz.
    // (Discord: kanala sag tik -> Kanal Kimligini Kopyala; Gelistirici Modu acik olmali)
    "DISCORD_UPLOAD_CHANNEL_ID": "1533290379003035811"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
